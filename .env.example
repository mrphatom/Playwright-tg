REQUIRED
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ACCESS CONTROL
# Set PUBLIC_MODE=true only after completing the public-release security checklist.
PUBLIC_MODE=false
# Legacy private-mode/admin bootstrap IDs. Keep server-side only.
ALLOWED_TELEGRAM_USERS=12345678,98765432
ADMIN_TELEGRAM_IDS=12345678
DOMAIN POLICY SEEDS (comma-separated exact domains or *.subdomain patterns; public mode denies all when empty)
ALLOWED_DOMAINS=github.com,amazon.com,news.ycombinator.com,reddit.com
CONCURRENCY CONTROL & TIMEOUTS
MAX_CONCURRENT_TASKS=3
COMMAND_TIMEOUT=90
PORT=8080
DASHBOARD_BASE_URL=https://your-dashboard-domain.example
PRO_PLAN_STARS=750
MAX_PLAN_STARS=1000
PRO_PLAN_QUOTA=1000
MAX_PLAN_QUOTA=5000
REFERRER_BONUS_UNITS=20
DEVELOPER_QUOTA_LIMIT=250
# Required for production API-key hashing; use a dedicated random secret, never reuse a user credential.
API_KEY_HASH_SECRET=
# Optional HTTPS external crypto checkout provider. Telegram digital services still use Stars in Telegram.
CRYPTO_CHECKOUT_URL=
AES ENCRYPTION KEY FOR SESSIONS AT REST (Required for public mode; do not derive it from another secret)
SESSION_ENCRYPTION_KEY=
AI EXTRACTION
GEMINI_API_KEY=your_gemini_key_here
# Optional independent fallback keys. Keep all values in server-side secrets only.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.6-flash
TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
MULTIMODAL_MODEL=gemini-3.5-flash-lite
# Send quota/model alerts to ADMIN_TELEGRAM_IDS; alerts are rate-limited per model/category.
PROVIDER_ALERTS_ENABLED=true
PROVIDER_ALERT_COOLDOWN_SECONDS=900
# Durable affected-user notification delivery. The worker is retryable and idempotent.
NOTIFICATION_WORKER_ENABLED=true
# Preview-first administrator announcements, direct messages, and bulk moderation.
BULK_ACTIONS_ENABLED=true
# Owner-scoped developer event feed exposed through /devevents and developer APIs.
DEVELOPER_EVENTS_ENABLED=true
MAX_BULK_TARGETS=200
NOTIFICATION_POLL_SECONDS=5
# Inline mode works in any chat after enabling it in @BotFather with /setinline.
INLINE_ENABLED=true
GROUP_INVOCATION_ENABLED=true
# Telegram Business Mode direct replies for authorized connected business chats.
BUSINESS_MODE_ENABLED=true
# Keep channel invocation disabled until the bot is an administrator and the IDs are reviewed.
CHANNEL_INVOCATION_ENABLED=false
ALLOWED_CHANNEL_IDS=
INLINE_TIMEOUT_SECONDS=8
CHAT_TIMEOUT_SECONDS=20
MEDIA_TIMEOUT_SECONDS=45
# One-time developer API-key message lifetime; bounded by the bot to 30-300 seconds.
API_KEY_MESSAGE_TTL_SECONDS=90
MEDIA_MAX_BYTES=12000000
MAX_MEDIA_CONTEXT_CHARS=6000
CAPTCHA SOLVER (Optional)
CAPSOLVER_API_KEY=your_capsolver_key_here
PROXIES (Optional)
PROXY_SERVER=http://pr.oxylab.net:8000
PROXY_USERNAME=your_proxy_user
PROXY_PASSWORD=your_proxy_pass

# Role-targeted administrator messaging; recipients are resolved server-side by role and status.
ROLE_MESSAGING_ENABLED=true
# Administrator maintenance/status controls and public timestamped status history.
MAINTENANCE_FEATURE_ENABLED=true
# Automatically snapshot sanitized runtime state and enter hard maintenance on unhandled failures.
CRASH_FAILSAFE_ENABLED=true
# Priority-aware browser queue. Free users are accepted fairly but receive lower priority and an ETA.
QUEUE_ENABLED=true
QUEUE_MAX_DEPTH=100
QUEUE_POLL_SECONDS=1
QUEUE_ETA_FLOOR_SECONDS=5
