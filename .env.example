REQUIRED
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional Discord adapter. Keep the token in Fly/GitHub secret storage; never commit or paste it.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Comma-separated numeric Discord server IDs. Empty means DMs only; no guild is enabled by default.
DISCORD_ALLOWED_GUILD_IDS=
# Comma-separated numeric Discord channel IDs. Guild traffic is denied unless both lists match.
DISCORD_ALLOWED_CHANNEL_IDS=
# Minimum seconds between pairing challenges for the same Discord identity; application-bounded to 5–300.
PAIRING_CHALLENGE_COOLDOWN_SECONDS=30
ACCESS CONTROL
# Set PUBLIC_MODE=true only after completing the public-release security checklist.
PUBLIC_MODE=false
# Legacy private-mode/admin bootstrap IDs. Keep server-side only.
ALLOWED_TELEGRAM_USERS=12345678,98765432
ADMIN_TELEGRAM_IDS=12345678
# Optional explicit creator/owner identity used in Grey’s native context; falls back to configured admin IDs.
GREY_OWNER_TELEGRAM_ID=12345678
GREY_OWNER_LABEL=the configured GreyAI owner
DOMAIN POLICY SEEDS (comma-separated exact domains or *.subdomain patterns; public mode denies all when empty)
ALLOWED_DOMAINS=github.com,githubusercontent.com,raw.githubusercontent.com,amazon.com,news.ycombinator.com,google.com,coinmarketcap.com,duckduckgo.com,bing.com,brave.com,startpage.com,reddit.com,archive.org,freemusicarchive.org,pypi.org,files.pythonhosted.org,npmjs.com,registry.npmjs.org,crates.io,static.crates.io,rubygems.org,sourceforge.net,codeberg.org,gitlab.com,releases.ubuntu.com,cdimage.debian.org,download.docker.com,python.org,docs.python.org,developer.mozilla.org,w3.org
CONCURRENCY CONTROL & TIMEOUTS
MAX_CONCURRENT_TASKS=3
COMMAND_TIMEOUT=90
# Show a persistent “still thinking” message only after this delay; bounded to 0.5–3.0 seconds.
PROGRESS_FEEDBACK_DELAY_SECONDS=1.2
PORT=8080
DASHBOARD_BASE_URL=https://your-dashboard-domain.example
PRO_PLAN_STARS=750
MAX_PLAN_STARS=1000
PRO_PLAN_QUOTA=1000
MAX_PLAN_QUOTA=5000
REFERRER_BONUS_UNITS=20
DEVELOPER_QUOTA_LIMIT=250
# Required for production API-key hashing; use a dedicated random secret, never reuse a user credential.
API_KEY_HASH_SECRET=
# Optional HTTPS external crypto checkout provider. Telegram digital services still use Stars in Telegram.
CRYPTO_CHECKOUT_URL=
AES ENCRYPTION KEY FOR SESSIONS AT REST (Required for public mode; do not derive it from another secret)
SESSION_ENCRYPTION_KEY=
AI EXTRACTION
GEMINI_API_KEY=your_gemini_key_here
# Optional independent fallback keys. Keep all values in server-side secrets only.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Optional approved search provider. Keep the API key server-side and never commit it.
GOOGLE_CUSTOM_SEARCH_ENABLED=false
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
GOOGLE_CUSTOM_SEARCH_TIMEOUT_SECONDS=8
GOOGLE_CUSTOM_SEARCH_RESULTS=5
# Public search fallback order: DuckDuckGo, Bing, Brave Search, Startpage.
DUCKDUCKGO_ENABLED=true
BING_SEARCH_ENABLED=true
BRAVE_SEARCH_ENABLED=true
STARTPAGE_SEARCH_ENABLED=true
# Self-hosted Tor startup is disabled by default outside the Fly production image.
TOR_LOCAL_ENABLED=false
TOR_LOCAL_SOCKS_PORT=9050
TOR_PUBLIC_FALLBACK_ENABLED=false
TOR_ONION_ACCESS_ENABLED=false
TOR_PROXY_SERVER=
TOR_PROXY_USERNAME=
TOR_PROXY_PASSWORD=
# Explicit comma-separated .onion host patterns; never leave broad access implicit.
# Green/free and Pro tiers are denied; only Max or governed roles can qualify.
TOR_ONION_ALLOWLIST=
GEMINI_MODEL=gemini-3.6-flash
TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
MULTIMODAL_MODEL=gemini-3.5-flash-lite
# Send quota/model alerts to ADMIN_TELEGRAM_IDS; alerts are rate-limited per model/category.
PROVIDER_ALERTS_ENABLED=true
PROVIDER_ALERT_COOLDOWN_SECONDS=900
# Durable affected-user notification delivery. The worker is retryable and idempotent.
NOTIFICATION_WORKER_ENABLED=true
# Preview-first administrator announcements, direct messages, and bulk moderation.
BULK_ACTIONS_ENABLED=true
# Owner-scoped developer event feed exposed through /devevents and developer APIs.
DEVELOPER_EVENTS_ENABLED=true
MAX_BULK_TARGETS=200
NOTIFICATION_POLL_SECONDS=5
# Inline mode works in any chat after enabling it in @BotFather with /setinline.
INLINE_ENABLED=true
GROUP_INVOCATION_ENABLED=true
# Telegram Business Mode direct replies for authorized connected business chats.
BUSINESS_MODE_ENABLED=true
# Keep channel invocation disabled until the bot is an administrator and the IDs are reviewed.
CHANNEL_INVOCATION_ENABLED=false
ALLOWED_CHANNEL_IDS=
INLINE_TIMEOUT_SECONDS=8
CHAT_TIMEOUT_SECONDS=20
# Structured intent output budget; keep routing concise and predictable (256-1024).
ROUTER_MAX_OUTPUT_TOKENS=768
# Number of durable conversation turns loaded per owner/chat context; history remains in SQLite across restarts.
CHAT_CONTEXT_TURNS=32
MEDIA_TIMEOUT_SECONDS=45
# One-time developer API-key message lifetime; bounded by the bot to 30-300 seconds.
API_KEY_MESSAGE_TTL_SECONDS=90
# Generated Telegram bot starter ZIPs are deleted from the chat after this bounded window.
DEVELOPER_ARTIFACT_TTL_SECONDS=600
# AI-directed read-only navigation for in-site search, semantic links, and bounded extraction.
INTELLIGENT_NAVIGATION_ENABLED=true
INTELLIGENT_NAVIGATION_MAX_STEPS=5
INTELLIGENT_NAVIGATION_MAX_ELEMENTS=80
INTELLIGENT_NAVIGATION_PAGE_TEXT_CHARS=6000
MEDIA_MAX_BYTES=12000000
MAX_MEDIA_CONTEXT_CHARS=6000
# Lawful file retrieval: Free is blocked by default; Pro is size/rate limited; Max/developer/admin are more generous but still bounded.
DOWNLOADS_ENABLED=true
DOWNLOAD_FREE_ENABLED=false
DOWNLOAD_PRO_MAX_BYTES=25000000
DOWNLOAD_MAX_BYTES=100000000
DOWNLOAD_PRO_MAX_JOBS_PER_DAY=2
DOWNLOAD_MAX_JOBS_PER_DAY=10
DOWNLOAD_MAX_CONCURRENT=2
DOWNLOAD_RATE_LIMIT_SECONDS=60
DOWNLOAD_PROGRESS_INTERVAL_SECONDS=10
DOWNLOAD_TIMEOUT_SECONDS=600
DOWNLOAD_MAX_REDIRECTS=3
DOWNLOAD_MAX_ARCHIVE_MEMBERS=1000
DOWNLOAD_MAX_ARCHIVE_UNPACKED_BYTES=200000000
# Executable installers, scripts, and archive members are always blocked by the artifact validator.
# Keep .onion access explicit and administrator-governed; do not seed marketplaces or broad wildcards.
# Grey does not integrate a CAPTCHA solver or bypass service; CAPTCHA challenges require manual review.
PROXIES (Optional)
PROXY_SERVER=http://pr.oxylab.net:8000
PROXY_USERNAME=your_proxy_user
PROXY_PASSWORD=your_proxy_pass

# Role-targeted administrator messaging; recipients are resolved server-side by role and status.
ROLE_MESSAGING_ENABLED=true
# Administrator-only advertising campaigns. A preview and /confirmad are required before posting.
AD_CAMPAIGNS_ENABLED=true
MAX_AD_CAMPAIGN_TARGETS=20
MAX_AD_CAMPAIGN_REPEATS=10
MIN_AD_INTERVAL_SECONDS=3600
AD_CAMPAIGN_POLL_SECONDS=30
AD_CAMPAIGN_MAX_BODY=1200
AD_CAMPAIGN_COOLDOWN_SECONDS=3600
# Pause a campaign after this many distinct targets lose membership or posting permission; 0 disables auto-pause.
AD_CAMPAIGN_PERMISSION_LOSS_PAUSE_THRESHOLD=2
# Administrator maintenance/status controls and public timestamped status history.
MAINTENANCE_FEATURE_ENABLED=true
MAINTENANCE_SCHEDULER_POLL_SECONDS=15
# Automatically snapshot sanitized runtime state and enter hard maintenance on unhandled failures.
CRASH_FAILSAFE_ENABLED=true
# Auto-recover only automatic failsafe incidents after consecutive healthy dependency probes.
AUTO_RECOVERY_ENABLED=true
AUTO_RECOVERY_POLL_SECONDS=30
AUTO_RECOVERY_STABILITY_CHECKS=3
AUTO_RECOVERY_PROBE_TIMEOUT_SECONDS=8
# Priority-aware browser queue. Free users are accepted fairly but receive lower priority and an ETA.
QUEUE_ENABLED=true
QUEUE_MAX_DEPTH=100
QUEUE_POLL_SECONDS=1
QUEUE_ETA_FLOOR_SECONDS=5
